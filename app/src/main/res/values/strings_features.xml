    <string name="help_scan_title">Scan a sign</string>
    <string name="help_scan_body">Point the camera at some text. Tap the round button to take a photo, or hold it to read live.</string>
    <string name="help_languages_title">Choose your languages</string>
    <string name="help_languages_body">Use the two buttons above the camera: the language of the text, and the script you want to read it in.</string>
    <string name="help_tap_title">Tap to hear</string>
    <string name="help_tap_body">Tap a word on the picture to hear it. Press and hold a line to copy it. Greyed-out lines are ones the app is not sure about.</string>
    <string name="help_voice_title">Offline voice</string>
    <string name="help_voice_body">In Settings, open Voice and speech to download a natural Indian-language voice. It then works without internet.</string>
    <string name="help_type_title">Type to convert</string>
    <string name="help_type_body">Open the keyboard tab and type. The converted text appears as you type, and you can listen to both versions.</string>
    <string name="help_keyboard_title">Transliteration keyboard</string>
    <string name="help_keyboard_body">Type in English letters in any app and get Indian-language script. Turn it on in your phone\'s keyboard settings.</string>
    <string name="help_private_title">Private by design</string>
    <string name="help_private_body">Reading, converting and speaking all happen on your phone. Nothing you scan is sent anywhere.</string>
